<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET, ACCESS_NETWORK_STATE, FOREGROUND_SERVICE, FOREGROUND_SERVICE_DATA_SYNC and
         POST_NOTIFICATIONS merge in from :core, which does the networking and runs the sync and
         download workers. MODIFY_AUDIO_SETTINGS merges in from :player-core, which owns VolumeBoost.
         Three of the TV app's permissions are still deliberately absent:
           - WRITE_EPG_DATA — Watch Next is an Android TV surface,
           - MANAGE/READ/WRITE_EXTERNAL_STORAGE — a phone has a document picker; use SAF,
           - the leanback / optional-touchscreen uses-feature pair — this app is touch-first. -->

    <!-- The in-app updater, the same one the television has: distribution is sideloaded, so the app
         is the only thing that can tell you a new version exists. This was once listed above as a
         permission this app would never declare, on the grounds that Google Play scrutinises it on a
         media player. That is still true, and it is the owner's decision to carry it: Play is out of
         scope, and an update nobody hears about is not an update. **If this app ever goes to Play,
         this line and the update rows in Settings → App come out together.** -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- androidx.tvprovider declares both TV-provider permissions in its own manifest, and :core
         depends on it because LauncherIntegrationRepository (the facade core's sync worker calls)
         delegates to the Watch Next publisher. So they merge in here, into an app that can never use
         them: there is no TV launcher row on a phone. Removed explicitly rather than tolerated — a
         Watch Next permission on a phone app is the kind of thing a user reads in the app listing
         and does not forget. If core ever stops depending on tvprovider, delete these two lines. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA"
        tools:node="remove" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA"
        tools:node="remove" />

    <!-- Playback has to keep running when the app is off screen, and from Android 14 a foreground
         service must declare the type it is. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Coarse, never fine, and asked for only when the user turns on "Use this device's location"
         for the weather. A phone moves and a television does not: without it the forecast is
         looked up from the network address, which is whichever city the operator routes through.
         Weather is measured over tens of kilometres, so street-level accuracy would be data
         collected for no reason. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- One screen, one purpose: reading the QR code the television shows while pairing for local
         sync. Asked for at that moment and never held otherwise, and the whole feature still works
         without it — the address can be picked from the discovery list or typed in. Optional as a
         feature so a tablet without a camera can still install the app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".OwnTVMobileApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/owntv_icon_eggshell"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/owntv_icon_eggshell"
        android:supportsRtl="true"
        android:theme="@style/Theme.OwnTVMobile"
        android:usesCleartextTraffic="true"
        tools:targetApi="26">

        <!-- Disable WorkManager default auto-init; OwnTVMobileApp provides the Configuration, which
             is what installs core's Koin-aware WorkerFactory. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- One launcher activity per icon colour (core's AppIcon); AppIconSwitcher keeps exactly one
             enabled. MainActivity is the default (Eggshell) and keeps its name, so an icon placed before
             this change still opens the app. Each carries its own icon and launch-screen theme.
             configChanges is what Picture-in-Picture needs: without it every entry into and exit from the
             little window would rebuild the activity, and the stream would restart. It takes rotation
             with it, which a player app wants anyway.
             LAUNCHER only. No LEANBACK_LAUNCHER: this app is not for a ten-foot UI. -->
        <activity
            android:name=".MainActivityPetrol"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/owntv_icon_petrol"
            android:launchMode="singleTop"
            android:roundIcon="@mipmap/owntv_icon_petrol"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.OwnTVMobile.Starting.Petrol"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivitySunflower"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/owntv_icon_sunflower"
            android:launchMode="singleTop"
            android:roundIcon="@mipmap/owntv_icon_sunflower"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.OwnTVMobile.Starting.Sunflower"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivityCobalt"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/owntv_icon_cobalt"
            android:launchMode="singleTop"
            android:roundIcon="@mipmap/owntv_icon_cobalt"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.OwnTVMobile.Starting.Cobalt"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivityTomato"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/owntv_icon_tomato"
            android:launchMode="singleTop"
            android:roundIcon="@mipmap/owntv_icon_tomato"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.OwnTVMobile.Starting.Tomato"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivityBoard"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/owntv_icon_board"
            android:launchMode="singleTop"
            android:roundIcon="@mipmap/owntv_icon_board"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.OwnTVMobile.Starting.Board"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/owntv_icon_eggshell"
            android:launchMode="singleTop"
            android:roundIcon="@mipmap/owntv_icon_eggshell"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.OwnTVMobile.Starting.Eggshell"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivityOlive"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/owntv_icon_olive"
            android:launchMode="singleTop"
            android:roundIcon="@mipmap/owntv_icon_olive"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.OwnTVMobile.Starting.Olive"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivityOliveCream"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/owntv_icon_olive_cream"
            android:launchMode="singleTop"
            android:roundIcon="@mipmap/owntv_icon_olive_cream"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.OwnTVMobile.Starting.OliveCream"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- How the Cast SDK finds its configuration. It is instantiated reflectively by name, which
             is why the class is kept out of R8's reach in proguard-rules.pro. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="tv.own.owntv.mobile.cast.CastOptionsProvider" />

        <!-- Keeps the stream alive and puts it on the lockscreen. Not exported: it is driven by
             LiveTuner and by its own notification buttons, never by another app. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
