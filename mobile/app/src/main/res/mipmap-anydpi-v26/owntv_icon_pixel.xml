<?xml version="1.0" encoding="utf-8"?>
<!-- MPTV: overrides :core's icon of the same name, so every icon colour's launcher activity shows
     the MPTV icon (see mptv_icon_bg in colors.xml). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/mptv_icon_bg"/>
    <foreground android:drawable="@mipmap/mptv_icon_foreground"/>
</adaptive-icon>
