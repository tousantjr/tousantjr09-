<?xml version="1.0" encoding="utf-8"?>
<!--
  App-level brand overrides. :core ships defaults for these (app_name=OwnTV, brand_own=Own,
  brand_tv=TV) in donottranslate.xml; the app module's copy of a same-named resource wins during
  merge, so redefining just these three here rebrands the app without touching :core or any Kotlin.
  The content_search_* strings below the brand block are upstream's own.
-->
<resources>
    <string name="app_name" translatable="false">MPTV</string>
    <string name="brand_own" translatable="false">MP</string>
    <string name="brand_tv" translatable="false">TV</string>

    <!-- Extra one-tap DoH preset label on the DNS settings screen, shown as-is (domain name). -->
    <string name="dns_preset_bp_v2" translatable="false">bp-v2.net</string>

    <!-- Quick-switch between known provider login servers on the (editing-only) Add/Edit Source
         screen, so a dead server doesn't require a new app build to work around. -->
    <string name="setup_server_preset_title">Login server</string>
    <string name="setup_server_preset_desc">Switch to another known server from your provider if this one stops responding.</string>
    <string name="setup_server_preset_bp_v2" translatable="false">bp-v2.net</string>
    <string name="setup_server_preset_fixhdelite" translatable="false">fixhdelite.xyz</string>

    <string name="content_search_channels">Search channels\u2026</string>
    <string name="content_search_movies">Search movies…</string>
    <string name="content_search_series">Search series…</string>

    <!-- Settings → Diagnostics: read-only health checks (connection, playlist, TV guide, storage)
         plus a download speed test, inspired by a sibling fork's "Diagnostic Center". -->
    <string name="diagnostics_title">Diagnostics</string>
    <string name="diagnostics_root_desc">Check your connection, playlist, TV guide and storage</string>
    <string name="settings_search_keywords_diagnostics">diagnostics health check connection speed test guide storage</string>

    <string name="diagnostics_run_checks">Run checks</string>
    <string name="diagnostics_running">Running checks…</string>
    <string name="diagnostics_run_checks_help">Checks your internet connection, playlist account, TV guide freshness and free storage. Nothing is changed — these are read-only.</string>
    <string name="diagnostics_last_checked">Last checked %1$s</string>

    <string name="diagnostics_status_ok">OK</string>
    <string name="diagnostics_status_warning">Warning</string>
    <string name="diagnostics_status_problem">Problem</string>

    <string name="diagnostics_connection_title">Connection</string>
    <string name="diagnostics_connection_ok">Connected to the internet</string>
    <string name="diagnostics_connection_problem">No internet connection — check your network</string>

    <string name="diagnostics_streaming_heading">Streaming service &amp; playlist</string>
    <string name="diagnostics_no_sources">No playlist configured yet</string>

    <string name="diagnostics_epg_title">TV guide</string>
    <string name="diagnostics_epg_no_source">No TV guide configured for this profile</string>
    <string name="diagnostics_epg_no_data">No guide data downloaded yet — sync in EPG Sources</string>
    <string name="diagnostics_epg_fresh">Guide data from %1$s</string>
    <string name="diagnostics_epg_stale">Guide data is getting old — from %1$s. Sync in EPG Sources to refresh</string>
    <string name="diagnostics_epg_very_stale">Guide data is very old — from %1$s. Open EPG Sources and sync</string>
    <string name="diagnostics_epg_unknown_age">Guide data is present, but its last sync time is unknown</string>

    <string name="diagnostics_storage_title">Device storage</string>

    <string name="diagnostics_speed_test_title">Internet speed test</string>
    <string name="diagnostics_speed_test_desc">Downloads a small file from a public test server to measure your speed</string>
    <string name="diagnostics_speed_test_result">%1$s Mbps download</string>
    <string name="diagnostics_speed_test_failed">Speed test failed — check your connection</string>

    <!-- Settings → Layout → Home: additive, all-profiles filter for Home's Trending rail, separate
         from (and on top of) the existing kids-profile category hiding. -->
    <string name="settings_home_hide_adult_categories">Hide adult categories from Home</string>
    <string name="settings_home_hide_adult_categories_description">Keep categories matching adult content out of Trending on Home, for every profile</string>

    <!-- Sports hub → Upcoming: the next 7 days per followed league (today/tomorrow come from :core's
         own board already; this view calls EspnSportsSource directly for the days beyond that — see
         SportsUpcomingViewModel). "Today"/"Tomorrow" and the paused/retry wording are :core's own
         (content_epg_today, content_epg_tomorrow, sports_paused, common_retry) and are reused, not
         redefined, so this view never drifts from the rest of Sports or the guide. -->
    <string name="sports_upcoming_title">Upcoming</string>
    <string name="sports_upcoming_empty">No upcoming matches in the next 7 days for what you follow</string>
    <string name="sports_upcoming_partial_failure">Some leagues couldn\'t load</string>

    <!-- Sports hub → Boxing: a 7-day PPV/fight schedule from ESPN's boxing scoreboard. Unlike every
         other Sports view this is NOT core's Demand/Feed board (core's Sport enum has no BOXING case)
         — it is a separate, boxing-only fetch, cache and UI; see BoxingUpcomingViewModel/BoxingSource.
         "Today"/"Tomorrow", "Remind me" and the reminder tag are :core's own (content_epg_today,
         content_epg_tomorrow, content_remind_me, sports_reminder_set) and are reused, not redefined. -->
    <string name="boxing_title">Boxing</string>
    <string name="boxing_schedule_credit">Schedule: ESPN</string>
    <string name="boxing_empty">No boxing events found in the next 7 days</string>
    <string name="boxing_partial_failure">Couldn\'t load part of the boxing schedule</string>
    <string name="boxing_paused">Boxing schedule paused — trying again in a few minutes</string>
    <string name="boxing_find_channels">Find channels</string>
    <string name="boxing_searching_channels">Searching your channels…</string>
    <string name="boxing_no_channels_found">No matching channels found in your playlist</string>

    <!-- Home → subscription notice: a strip above the rows once an Xtream playlist's account ends
         within a week, or has ended (SubscriptionExpiry / SubscriptionNotice). %1$s is the playlist's
         name as the user named it; the date is formatted by the app. -->
    <plurals name="subscription_expires_title">
        <item quantity="one">Your %1$s subscription ends in %2$d day</item>
        <item quantity="other">Your %1$s subscription ends in %2$d days</item>
    </plurals>
    <string name="subscription_expires_body">It expires on %1$s — renew with your provider to keep watching.</string>
    <string name="subscription_expired_title">Your %1$s subscription has expired</string>
    <string name="subscription_expired_body">It ended on %1$s — renew with your provider to keep watching.</string>

    <!-- Player → failure overlay: the account's own connection numbers, under core's generic reason,
         when every connection is in use elsewhere (ConnectionLimitNotices). Core already says this
         for a panel that answers HTTP 458; most don't, so the account is asked after a failure. -->
    <string name="player_connection_limit_reached">Connection limit reached: %1$d of %2$d in use. This account is playing on other devices — stop one of them, then press Retry.</string>

    <!-- Home → Sports row → the featured game: a hero card above the row's match cards for the live
         followed match, else the next one kicking off within 12 hours (see FeaturedMatch). "Live now",
         "Find channels", "Remind me" and the Reminder tag are :core's own (sports_live_now,
         sports_find_channels, content_remind_me, sports_reminder_set) and are reused, not redefined. -->
    <string name="sports_featured_eyebrow">Tonight\'s game</string>
    <string name="sports_featured_eyebrow_next">Next game</string>
    <string name="sports_featured_kickoff_in">Kicks off in %1$s · %2$s</string>
    <string name="sports_featured_starting_now">Starting now · %1$s</string>
    <string name="sports_featured_hours_minutes">%1$dh %2$dm</string>
    <string name="sports_featured_minutes">%1$dm</string>
    <string name="sports_featured_no_channel">No channel found for this game yet — open it to search</string>

    <!-- Settings → Layout → Home: the focused Trending title's trailer plays, muted, inside the hero
         after a short dwell (TrendingTrailerPreview). App-level, its own DataStore (HomeTrailerSettings). -->
    <string name="settings_home_play_trailers">Play trailers on Home</string>
    <string name="settings_home_play_trailers_description">Play the focused title\'s trailer, muted, in the Home hero after a moment</string>

    <!-- Settings → Diagnostics, the Diagnostic Center (DiagnosticsScreen / DiagnosticsViewModel):
         fixes under the checks (re-sync a playlist or the guide, switch the Movies & Series engine),
         the app/device lines, quick fixes, and a report to show, copy or share. Counts reuse core's
         own sync-status plurals (sync_count_channels/movies/series/epg, sports_hub_matches); "Re-sync",
         "Check for updates", "Share", "Done" and "Restart now" are core's own words, reused. -->
    <string name="diagnostics_resync_playlist">Re-sync this playlist</string>
    <string name="diagnostics_resync_playlist_help">Fetches %1$s again from your provider — the same as Re-sync in Manage Sources. Favorites, history and resume positions are kept.</string>
    <string name="diagnostics_playlist_never_synced">Never synced</string>
    <string name="diagnostics_resync_epg">Re-sync TV guide</string>
    <plurals name="diagnostics_epg_feeds">
        <item quantity="one">%1$d guide feed</item>
        <item quantity="other">%1$d guide feeds</item>
    </plurals>
    <string name="diagnostics_epg_resync_playlist_only">Your guide comes with the playlist — use Re-sync this playlist above to refresh it</string>
    <string name="diagnostics_sports_title">Sports scores</string>
    <plurals name="diagnostics_sports_failing">
        <item quantity="one">%1$d score feed couldn\'t load — some scores may be missing</item>
        <item quantity="other">%1$d score feeds couldn\'t load — some scores may be missing</item>
    </plurals>
    <string name="diagnostics_sports_none">No scores loaded yet — open Sports to load them</string>
    <string name="diagnostics_app_heading">Player, app &amp; device</string>
    <string name="diagnostics_player_title">Movies &amp; Series player</string>
    <string name="diagnostics_player_help">Which engine movies and series start on. If a title won\'t play or stutters, switching to the other engine is the first thing to try — the same choice as in Video Player settings.</string>
    <string name="diagnostics_player_switch_to">Switch to %1$s</string>
    <string name="diagnostics_app_title">App version</string>
    <string name="diagnostics_app_version">Version %1$s (build %2$d)</string>
    <string name="diagnostics_app_help">The version you have. Check for updates looks for a newer release and installs it from here.</string>
    <string name="diagnostics_device_title">Device</string>
    <string name="diagnostics_device_line">%1$s · Android %2$s (API %3$d)</string>
    <string name="diagnostics_network_wifi">Wi-Fi</string>
    <string name="diagnostics_network_ethernet">Ethernet</string>
    <string name="diagnostics_network_cellular">Mobile data</string>
    <string name="diagnostics_network_other">Other network</string>
    <string name="diagnostics_network_none">No network</string>
    <string name="diagnostics_quick_fixes">Quick fixes</string>
    <string name="diagnostics_clear_image_cache">Clear image cache</string>
    <string name="diagnostics_clear_image_cache_desc">Drops cached posters and backdrops — they load again as you browse. Fixes wrong or missing artwork.</string>
    <string name="diagnostics_cache_cleared">Image cache cleared</string>
    <string name="diagnostics_open_app_settings">Open system app settings</string>
    <string name="diagnostics_open_app_settings_desc">The system\'s page for this app: storage, permissions and Force stop</string>
    <string name="diagnostics_restart_app">Restart app</string>
    <string name="diagnostics_restart_app_desc">Closes the app fully and opens it again — the fix for most things that only stop working after a while</string>
    <string name="diagnostics_report_heading">Report</string>
    <string name="diagnostics_show_report">Show report</string>
    <string name="diagnostics_show_report_desc">Everything the checks found, as text you can read, copy or share with your provider or support</string>
    <string name="diagnostics_copy_report">Copy report</string>
    <string name="diagnostics_copy_report_desc">Copies the report to the clipboard — no passwords or usernames are included</string>
    <string name="diagnostics_share_report">Share report</string>
    <string name="diagnostics_share_report_desc">Sends the report to another app — no passwords or usernames are included</string>
    <string name="diagnostics_report_copied">Report copied</string>
    <string name="diagnostics_report_title">Diagnostics report</string>
    <!-- One "label: value" line of the text report; the colon and its spacing are the locale's. -->
    <string name="diagnostics_report_pair">%1$s: %2$s</string>
    <string name="diagnostics_report_none">Run checks first</string>
    <string name="diagnostics_resync_queued">Re-sync started</string>
    <string name="diagnostics_share_unavailable">Nothing on this device can receive the report — copy it instead</string>
</resources>
